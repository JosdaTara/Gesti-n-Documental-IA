# Copiar a .env y ajustar. El .env real NO se sube al repositorio.
# SECRET_KEY: usar un valor aleatorio largo en producción.

SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Local con XAMPP MySQL:
#   mysql+pymysql://root:@localhost:3306/gestion_documental_bd?charset=utf8mb4
# SQLite (por defecto) o PostgreSQL 16 en producción:
#   sqlite:///./sigad.db
#   postgresql+psycopg2://sigad:sigad@db:5432/sigad
DATABASE_URL=mysql+pymysql://root:@localhost:3306/gestion_documental_bd?charset=utf8mb4

STORAGE_PATH=./storage
DEMO_MODE=true

# IA: basta con una de las tres. Con varias, el orden de prioridad es:
# OpenRouter > Gemini > OpenAI.
# OpenRouter (agrega muchos modelos con una sola key de https://openrouter.ai):
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
OPENROUTER_LLM_MODEL=openrouter/auto

# Gemini (recomendada, modelos de Google AI Studio):
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.5-flash

# OpenAI (alternativa):
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173