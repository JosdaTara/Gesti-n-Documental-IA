    {
      "id": "sigad-validar",
      "name": "Validar payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "const p = .first().json;\nconst d = (p && p.body && typeof p.body === 'object') ? p.body : p;\nconst nombreDoc = d.documento || d.nombre || d.titulo || 'Documento';\nconst categoria = d.categoria_sugerida || d.categoria || 'Sin categoria';\nconst confianzaNum = Number(d.confianza !== undefined && d.confianza !== null ? d.confianza : (d.score !== undefined && d.score !== null ? d.score : 0));\nconst confStr = String(confianzaNum);\nconst resumen = d.resumen || '';\nconst urlRev = d.url_revision || d.urlRevision || '';\nconst decision = d.decision || '';\nconst estado = d.estado || '';\nreturn [\n  {\n    json: {\n      ...d,\n      asunto_apertura: '[SIGAD] Revision pendiente: ' + nombreDoc + ' (' + categoria + ', ' + confStr + '% confianza)',\n      cuerpo_apertura: 'El motor de IA de SIGAD no alcanzo el umbral de confianza (70%) y el documento necesita tu decision.\\n\\nDocumento: ' + nombreDoc + '\\nCategoria sugerida: ' + categoria + '\\nConfianza: ' + confStr + '%\\nResumen IA: ' + resumen + '\\n\\nPara aprobar, corregir o rechazar abre la bandeja de revision:\\n' + urlRev,\n      asunto_cierre: '[SIGAD] Revision cerrada: ' + nombreDoc,\n      cuerpo_cierre: 'La revision del documento fue atendida.\\n\\nDocumento: ' + nombreDoc + '\\nDecision: ' + decision + '\\nEstado final: ' + estado + '\\nCategoria final: ' + categoria + '\\n\\nPuedes verificar el documento en SIGAD.'\n    }\n  }\n];\n"
      }
    },
    {
